<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="numeric" default-locale="en-US">
  <info>
    <title>The Receptors Thesis - Alphabetical Numeric</title>
    <id>http://www.zotero.org/styles/the-receptors-thesis-alphabetical-numeric</id>
    <link href="http://www.zotero.org/styles/the-receptors-thesis-alphabetical-numeric" rel="self"/>
    <author><name>Custom thesis style</name></author>
    <category citation-format="numeric"/>
    <category field="biology"/>
    <summary>Custom alphabetical-numbered style matching the supplied Springer Nature The Receptors chapter: square-bracket numeric citations and APA-like bibliography.</summary>
    <updated>2026-09-27T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with=". " delimiter=", " delimiter-precedes-last="always" and="symbol"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="issued">
    <date variable="issued" prefix=" (" suffix=").">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="title">
    <choose>
      <if type="book report thesis manuscript motion_picture song speech entry entry-dictionary entry-encyclopedia webpage post post-weblog graphic" match="any">
        <text variable="title" font-style="italic" suffix="."/>
      </if>
      <else>
        <text variable="title" suffix="."/>
      </else>
    </choose>
  </macro>

  <macro name="container">
    <choose>
      <if type="article-journal article-magazine article-newspaper" match="any">
        <group delimiter=", ">
          <text variable="container-title" font-style="italic"/>
          <text variable="volume" font-style="italic"/>
          <text variable="issue" prefix="(" suffix=")"/>
        </group>
      </if>
      <else-if type="chapter paper-conference entry-encyclopedia entry-dictionary" match="any">
        <group>
          <text term="in" text-case="capitalize-first" suffix=" "/>
          <names variable="editor" suffix=", ">
            <name initialize-with=". " delimiter=", " and="symbol"/>
            <label form="short" prefix=" (" suffix=")"/>
          </names>
          <text variable="container-title" font-style="italic"/>
        </group>
      </else-if>
    </choose>
  </macro>

  <macro name="publisher">
    <choose>
      <if type="book chapter report thesis paper-conference" match="any">
        <group delimiter=": ">
          <text variable="publisher-place"/>
          <text variable="publisher"/>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="pages">
    <choose>
      <if variable="page">
        <text variable="page"/>
      </if>
      <else-if variable="number-of-pages">
        <text variable="number-of-pages" suffix=" pp."/>
      </else-if>
    </choose>
  </macro>

  <macro name="doi-url">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </if>
      <else-if variable="URL">
        <text variable="URL"/>
      </else-if>
    </choose>
  </macro>

  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography et-al-min="1000" et-al-use-first="999" second-field-align="flush" entry-spacing="0" line-spacing="1">
    <sort>
      <key macro="author"/>
      <key variable="title"/>
      <key variable="issued"/>
    </sort>
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <group>
        <group delimiter="">
          <text macro="author"/>
          <text macro="issued"/>
        </group>
        <text macro="title" prefix=" "/>
        <choose>
          <if type="article-journal article-magazine article-newspaper" match="any">
            <group prefix=" " delimiter=", ">
              <text macro="container"/>
              <text macro="pages"/>
            </group>
          </if>
          <else-if type="chapter paper-conference entry-encyclopedia entry-dictionary" match="any">
            <group prefix=" " delimiter=", ">
              <text macro="container"/>
              <text macro="pages"/>
              <text macro="publisher"/>
            </group>
          </else-if>
          <else>
            <group prefix=" " delimiter=", ">
              <text macro="publisher"/>
            </group>
          </else>
        </choose>
        <text macro="doi-url" prefix=" "/>
      </group>
    </layout>
  </bibliography>
</style>
